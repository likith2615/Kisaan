# Kisan Saathi — Environment Variables Template
# Copy this file to .env and fill in your actual values

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# VAPID Keys for Web Push Notifications
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@example.com
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Google AI Studio / Gemini LLM API Configuration
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-google-api-key

# Sarvam AI Voice Suite (Bulbul v3 Female Telugu TTS & Saaras v3 STT)
SARVAM_API_KEY=your-sarvam-api-key
VITE_SARVAM_API_KEY=your-sarvam-api-key
SARVAM_TELUGU_SPEAKER=meera
SARVAM_TTS_MODEL=bulbul:v3
